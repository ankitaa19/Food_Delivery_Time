FROM python:3.12-slim

WORKDIR /app

# Copy API requirements first for better caching
COPY api/requirements.txt .

# Install API dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy entire project structure (needed for MLflow registry access)
COPY . .

# The application needs mlflow.db and mlruns/ to access the registered model
# These are mounted via docker-compose, but we ensure the directory structure exists
RUN mkdir -p mlruns

# Expose port 8000
EXPOSE 8000

# Set environment variable for MLflow tracking URI
ENV MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8000/health', timeout=5)" || exit 1

# Run the FastAPI application
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
