FROM python:3.12-slim

WORKDIR /app

# Copy frontend requirements first for better caching
COPY frontend_requirements.txt .

# Install frontend dependencies
RUN pip install --no-cache-dir -r frontend_requirements.txt

# Copy the Streamlit app
COPY app.py .

# Expose port 8501
EXPOSE 8501

# Set environment variable for FastAPI URL (will be overridden by docker-compose)
ENV FASTAPI_URL=http://localhost:8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8501', timeout=5)" || exit 1

# Run the Streamlit application
CMD ["streamlit", "run", "app.py", "--server.port=8501", "--server.address=0.0.0.0"]
